# Environment Variables
# Copy this file to .env and fill in your values

# Site Configuration
VITE_SITE_URL=https://vantageengineering.example
VITE_SITE_NAME=VANTAGE Engineering Group

# API Configuration (Optional - for future backend integration)
# VITE_API_URL=https://api.yourdomain.com
# VITE_API_KEY=your-api-key

# Supabase (Optional - for form submissions, etc.)
# VITE_SUPABASE_URL=your-project-url
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Analytics (Optional)
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_HOTJAR_ID=XXXXXXX

# Contact Form (Optional - if using external service)
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
